# Robinhood Chain (4663). Solana dRPC Geyser is a separate opt-in stream.
DRPC_KEY=
DRPC_GEYSER=0
# dRPC "Solana Geyser gRPC" card endpoint (dashboard > API Keys > key > Solana Geyser gRPC). x-token = DRPC_KEY
DRPC_GEYSER_URL=
# Latest-head ERC-20 Transfer and indexed v4 Swap counts. Unfinalized and
# rollback-aware; separate from scored Research and historical replay.
RH_PROVISIONAL_SOURCE=0
# Full finalized RH holder and price replay. This can read chain history and
# must be cost-tested before enabling; incomplete coverage never scores.
RH_RESEARCH_SOURCE=0

# Primary executed Solana Yellowstone gRPC: Helius LaserStream, FluxRPC, or another compatible provider.
# Supply both values to start exactly one primary executed stream. Keep the token server-side.
YELLOWSTONE_GRPC_URL=
YELLOWSTONE_X_TOKEN=
# Per executed Yellowstone lane, persisted rolling-hour protobuf payload telemetry.
# Unset/0 never pauses live discovery. A positive value opts into a circuit breaker.
# Provider-billed traffic can differ from this estimate; compare dashboard usage.
YELLOWSTONE_MAX_MIB_PER_HOUR=0
# Helius Parsed Streams costs 1 credit per delivered event and filters FTL
# instructions server-side. Flux broadens to all venues if this connection fails.
HELIUS_PARSED_STREAM=0
HELIUS_LASERSTREAM_URL=https://laserstream-mainnet-ewr.helius-rpc.com
# Separate targeted per-mint Research replay; off until explicitly enabled.
HELIUS_TARGETED_STREAM=0
# The combined finalized block-time/mint stream measures protobuf bytes.
# Unset/0 never cuts off coverage; a positive value opts into a breaker.
HELIUS_BLOCKTIME_MAX_MIB_PER_HOUR=0

# Legacy Triton Dragon's Mouth lanes. Each costs a separate stream and is off until explicitly enabled.
TRITON_GEYSER=0
TRITON_DESHRED=0
TRITON_GRPC_URL=
TRITON_X_TOKEN=
# Triton Preconfs: separate token and explicit region list; no implicit token or region fallback.
TRITON_PRECONFS=0
TRITON_PRECONFS_URL=https://preconfs.rpcpool.com
TRITON_PRECONFS_TOKEN=
TRITON_PRECONFS_REGIONS=

# Server-side Solana JSON-RPC for metadata and address lookup tables.
# Standard methods can use FluxRPC, Helius, or another Solana RPC provider.
SOLANA_RPC_URL=
# Executable Solana quote/swap service, accessed by the server only.
# Local development: http://127.0.0.1:8087
SOLANA_ROUTER_URL=
# Set only after a direct FTL-pool quote and unsigned swap are simulated on
# mainnet with this deployment's Solana RPC. Uses local venue SDKs; no aggregator.
SOLANA_SELF_ROUTER=0
# Helius DAS-capable server endpoint for getAssetBatch (10 credits/call) and
# raw mint-account/holder reads (ordinary RPC, about 1 credit/call).
# A Helius Secure RPC URL works here; keep its unique hostname server-side.
# Falls back to SOLANA_RPC_URL if unset. Set to off to disable DAS.
SOLANA_DAS_URL=
# Shared daily cap for metadata RPC calls, including DAS and on-chain fallbacks.
META_RPC_DAILY_LIMIT=0
# One-time historical token-program identity: confirmed launch evidence first,
# then one Helius getMultipleAccounts read per remaining unknown mint and each
# Token-2022 mint needing raw extension proof, batched 20 mints per call.
# Off by default. One batch at a time, paced by the interval. Daily limits
# are opt-in; 0 records usage without an arbitrary cutoff. Transient errors
# retry with backoff, while request counts and unresolved backlog persist.
HOLDER_PROGRAM_BACKFILL=0
HOLDER_PROGRAM_RPC_DAILY_LIMIT=0
HOLDER_PROGRAM_BACKFILL_INTERVAL_MS=2000
# Optional one-read holder bootstrap for each Solana mint FTL has seen.
# Requires an explicit Helius SOLANA_DAS_URL and verified targeted stream.
# At most one getProgramAccountsV2 call per mint, paced by this interval.
# A failed/cursor response remains unavailable; there is no retry or polling.
# Token-2022 requires complete raw mint TLV proof of transparent balances.
HOLDER_BOOTSTRAP=0
HOLDER_BOOTSTRAP_INTERVAL_MS=10000
# Operator proof only: one exact FTL-seen Solana mint. Unset for full queue.
HOLDER_BOOTSTRAP_PROBE_MINT=

# Helius Wallet Kit (web). Both are required; never put HELIUS_API_KEY in the app bundle.
# Comma-separated exact browser origins allowed to reach the Fly wallet proxy.
HELIUS_API_KEY=
HELIUS_WAAS_ORIGINS=https://liquidityxyz.fun
# Optional keyless Secure RPC URL from the Helius dashboard. Public browser use
# is intended; this avoids routing wallet RPC reads through the Fly proxy.
HELIUS_WAAS_SECURE_RPC_URL=
PORT=8080
DATA_DIR=./data
