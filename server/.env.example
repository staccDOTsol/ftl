# Robinhood Chain (4663) + optional Solana Geyser via dRPC
DRPC_KEY=
# dRPC "Solana Geyser gRPC" card endpoint (dashboard > API Keys > key > Solana Geyser gRPC). x-token = DRPC_KEY
DRPC_GEYSER_URL=
# Triton One Dragon's Mouth (Yellowstone gRPC) — Subscribe + SubscribeDeshred
TRITON_GRPC_URL=
TRITON_X_TOKEN=
# Triton Preconfs (Harmonic / BAM) — separate subscription token
TRITON_PRECONFS_URL=https://preconfs.rpcpool.com
TRITON_PRECONFS_TOKEN=
TRITON_PRECONFS_REGIONS=harmonic:ewr,bam:ewr
# Solana JSON-RPC for metadata (Triton RPC or dRPC https://lb.drpc.live/solana/<key>)
SOLANA_RPC_URL=
PORT=8080
DATA_DIR=./data
